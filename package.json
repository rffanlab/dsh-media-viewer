{
  "name": "dsh-media-viewer",
  "version": "0.3.0",
  "type": "module",
  "main": "index.js",
  "description": "DeepSeek Harness 0.2.x media enhancement renderer: seekable video/audio playback, subtitles, HTTP Range streaming and media downloads.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rffanlab/dsh-media-viewer.git"
  },
  "homepage": "https://github.com/rffanlab/dsh-media-viewer#readme",
  "bugs": {
    "url": "https://github.com/rffanlab/dsh-media-viewer/issues"
  },
  "engines": {
    "node": ">=20.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "media",
    "video",
    "audio",
    "subtitle",
    "range-streaming",
    "sidebar",
    "preview"
  ],
  "dependencies": {},
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
